{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-dev",
      "displayName": "Shape native development",
      "generator": "Ninja",
      "binaryDir": "${sourceParentDir}/.shape-local-build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "desktop-dev",
      "inherits": "native-dev",
      "displayName": "Shape desktop development",
      "cacheVariables": {
        "SHAPE_BUILD_DESKTOP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-dev",
      "configurePreset": "native-dev"
    },
    {
      "name": "desktop-dev",
      "configurePreset": "desktop-dev"
    }
  ],
  "testPresets": [
    {
      "name": "native-dev",
      "configurePreset": "native-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-dev",
      "configurePreset": "desktop-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
